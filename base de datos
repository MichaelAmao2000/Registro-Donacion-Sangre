/* ============================================================
   5. IMPLEMENTACIÓN DE VISTAS
   ============================================================ */

-- VISTA 1: DONANTES
CREATE VIEW dbo.vista_donantes
AS
SELECT
    id_donante,
    dni,
    nombres,
    apellidos,
    grupo_sanguineo,
    factor_rh,
    telefono,
    disponibilidad
FROM dbo.DONANTE;
GO

-- VISTA 2: INVENTARIO DISPONIBLE
CREATE VIEW dbo.vista_inventario_disponible
AS
SELECT
    codigo,
    componente_sanguineo,
    grupo_sanguineo,
    factor_rh,
    volumen_ml,
    fecha_extraccion,
    fecha_vencimiento,
    estado
FROM dbo.UNIDAD_INVENTARIO
WHERE estado = 'Disponible'
AND fecha_vencimiento >= CAST(GETDATE() AS DATE);
GO

-- VISTA 3: HISTORIAL DE DONACIONES
CREATE VIEW dbo.vista_historial_donaciones
AS
SELECT
    d.id_donacion,
    dn.dni,
    dn.nombres,
    dn.apellidos,
    d.fecha_donacion,
    d.cantidad_ml,
    d.estado
FROM dbo.DONACION d
INNER JOIN dbo.DONANTE dn
    ON d.id_donante = dn.id_donante;
GO

-- VISTA 4: SOLICITUDES DE EMERGENCIA
CREATE VIEW dbo.vista_solicitudes
AS
SELECT
    id_solicitud,
    institucion,
    componente_sanguineo,
    grupo_requerido,
    factor_rh,
    cantidad,
    prioridad,
    fecha_solicitud,
    estado
FROM dbo.SOLICITUD_EMERGENCIA;
GO

-- VISTA 5: PARTICIPANTES DE CAMPAÑAS
CREATE VIEW dbo.vista_participantes_campania
AS
SELECT
    c.nombre AS campania,
    c.fecha,
    dn.nombres,
    dn.apellidos,
    dn.dni,
    p.fecha_registro,
    p.estado
FROM dbo.PARTICIPACION_CAMPANIA p
INNER JOIN dbo.CAMPANIA c
    ON p.id_campania = c.id_campania
INNER JOIN dbo.DONANTE dn
    ON p.id_donante = dn.id_donante;
GO


/* ============================================================
   6. FUNCIÓN Y TRIGGER DE DISPONIBILIDAD
   ============================================================ */

CREATE FUNCTION dbo.fn_estado_donante()
RETURNS VARCHAR(30)
AS
BEGIN
    RETURN 'La disponibilidad requiere evaluacion medica';
END;
GO

CREATE TRIGGER dbo.trg_actualizar_disponibilidad
ON dbo.DONACION
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE dn
    SET disponibilidad = 0
    FROM dbo.DONANTE dn
    INNER JOIN inserted i
        ON dn.id_donante = i.id_donante;
END;
GO


/* ============================================================
   7. TRIGGER DE VENCIMIENTO DE UNIDADES
   ============================================================ */

CREATE TRIGGER dbo.trg_verificar_vencimiento
ON dbo.UNIDAD_INVENTARIO
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE u
    SET estado = 'Vencida'
    FROM dbo.UNIDAD_INVENTARIO u
    INNER JOIN inserted i
        ON u.id_unidad = i.id_unidad
    WHERE i.fecha_vencimiento < CAST(GETDATE() AS DATE)
      AND i.estado <> 'Utilizada';
END;
GO


/* ============================================================
   8. PROCEDIMIENTO ALMACENADO
   REGISTRAR SOLICITUD DE EMERGENCIA
   ============================================================ */

CREATE PROCEDURE dbo.registrar_solicitud
    @institucion VARCHAR(150),
    @componente VARCHAR(50),
    @grupo VARCHAR(2),
    @rh VARCHAR(3),
    @cantidad INT,
    @prioridad VARCHAR(20)
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.SOLICITUD_EMERGENCIA
    (
        institucion,
        componente_sanguineo,
        grupo_requerido,
        factor_rh,
        cantidad,
        prioridad,
        estado
    )
    VALUES
    (
        @institucion,
        @componente,
        @grupo,
        @rh,
        @cantidad,
        @prioridad,
        'Pendiente'
    );
END;
GO


