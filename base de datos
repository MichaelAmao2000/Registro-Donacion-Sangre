/* ============================================================
   2. CREACIÓN DE LAS TABLAS
   ============================================================ */

-- 1. TABLA ROL
CREATE TABLE dbo.ROL (
    id_rol INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE,
    descripcion VARCHAR(255)
);
GO

-- 2. TABLA USUARIO
CREATE TABLE dbo.USUARIO (
    id_usuario INT IDENTITY(1,1) PRIMARY KEY,
    id_rol INT NOT NULL,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    correo VARCHAR(150) UNIQUE,
    nombre_usuario VARCHAR(50) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    estado BIT NOT NULL DEFAULT 1,

    CONSTRAINT FK_USUARIO_ROL
        FOREIGN KEY (id_rol)
        REFERENCES dbo.ROL(id_rol)
);
GO

-- 3. TABLA DONANTE
CREATE TABLE dbo.DONANTE (
    id_donante INT IDENTITY(1,1) PRIMARY KEY,
    dni VARCHAR(8) NOT NULL UNIQUE,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    fecha_nacimiento DATE NOT NULL,
    telefono VARCHAR(15),
    correo VARCHAR(150),
    grupo_sanguineo VARCHAR(2) NOT NULL,
    factor_rh VARCHAR(3) NOT NULL,
    disponibilidad BIT NOT NULL DEFAULT 1,
    fecha_registro DATE NOT NULL DEFAULT GETDATE(),

    CONSTRAINT CK_DONANTE_DNI
        CHECK (dni NOT LIKE '%[^0-9]%' AND LEN(dni) = 8),

    CONSTRAINT CK_DONANTE_GRUPO
        CHECK (grupo_sanguineo IN ('A','B','AB','O')),

    CONSTRAINT CK_DONANTE_RH
        CHECK (factor_rh IN ('+','-'))
);
GO

-- 4. TABLA SOLICITUD_EMERGENCIA
CREATE TABLE dbo.SOLICITUD_EMERGENCIA (
    id_solicitud INT IDENTITY(1,1) PRIMARY KEY,
    institucion VARCHAR(150) NOT NULL,
    componente_sanguineo VARCHAR(50) NOT NULL,
    grupo_requerido VARCHAR(2) NOT NULL,
    factor_rh VARCHAR(3) NOT NULL,
    cantidad INT NOT NULL,
    prioridad VARCHAR(20) NOT NULL,
    fecha_solicitud DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    estado VARCHAR(30) NOT NULL DEFAULT 'Pendiente',

    CONSTRAINT CK_SOLICITUD_GRUPO
        CHECK (grupo_requerido IN ('A','B','AB','O')),

    CONSTRAINT CK_SOLICITUD_RH
        CHECK (factor_rh IN ('+','-')),

    CONSTRAINT CK_SOLICITUD_CANTIDAD
        CHECK (cantidad > 0),

    CONSTRAINT CK_SOLICITUD_PRIORIDAD
        CHECK (prioridad IN ('Baja','Media','Alta','Urgente')),

    CONSTRAINT CK_SOLICITUD_COMPONENTE
        CHECK (componente_sanguineo IN (
            'Concentrado de globulos rojos',
            'Plaquetas',
            'Plasma'
        ))
);
GO

-- 5. TABLA CAMPANIA
CREATE TABLE dbo.CAMPANIA (
    id_campania INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    fecha DATE NOT NULL,
    horario TIME NOT NULL,
    lugar VARCHAR(150) NOT NULL,
    objetivo VARCHAR(500),
    estado VARCHAR(30) NOT NULL DEFAULT 'Programada',

    CONSTRAINT CK_CAMPANIA_ESTADO
        CHECK (estado IN (
            'Programada',
            'En curso',
            'Finalizada',
            'Cancelada'
        ))
);
GO

-- 6. TABLA RESPUESTA_SOLICITUD
CREATE TABLE dbo.RESPUESTA_SOLICITUD (
    id_respuesta INT IDENTITY(1,1) PRIMARY KEY,
    id_donante INT NOT NULL,
    id_solicitud INT NOT NULL,
    fecha_notificacion DATETIME2,
    fecha_respuesta DATETIME2,
    medio_notificacion VARCHAR(20),
    estado_notificacion VARCHAR(30) DEFAULT 'Pendiente',
    respuesta VARCHAR(30) NOT NULL DEFAULT 'Sin respuesta',

    CONSTRAINT FK_RESPUESTA_DONANTE
        FOREIGN KEY (id_donante)
        REFERENCES dbo.DONANTE(id_donante),

    CONSTRAINT FK_RESPUESTA_SOLICITUD
        FOREIGN KEY (id_solicitud)
        REFERENCES dbo.SOLICITUD_EMERGENCIA(id_solicitud),

    CONSTRAINT UQ_RESPUESTA_DONANTE_SOLICITUD
        UNIQUE (id_donante, id_solicitud),

    CONSTRAINT CK_RESPUESTA_MEDIO
        CHECK (
            medio_notificacion IS NULL OR
            medio_notificacion IN (
                'SMS','Correo','Llamada','Presencial'
            )
        ),

    CONSTRAINT CK_RESPUESTA_ESTADO
        CHECK (respuesta IN (
            'Sin respuesta','Aceptada','Rechazada'
        )),

    CONSTRAINT CK_RESPUESTA_NOTIFICACION
        CHECK (estado_notificacion IN (
            'Pendiente','Enviada','Fallida'
        ))
);
GO

-- 7. TABLA EVALUACION_DONANTE
CREATE TABLE dbo.EVALUACION_DONANTE (
    id_evaluacion INT IDENTITY(1,1) PRIMARY KEY,
    id_donante INT NOT NULL,
    id_usuario INT NOT NULL,
    fecha DATE NOT NULL DEFAULT GETDATE(),
    resultado VARCHAR(50) NOT NULL,
    observaciones VARCHAR(500),

    CONSTRAINT FK_EVALUACION_DONANTE
        FOREIGN KEY (id_donante)
        REFERENCES dbo.DONANTE(id_donante),

    CONSTRAINT FK_EVALUACION_USUARIO
        FOREIGN KEY (id_usuario)
        REFERENCES dbo.USUARIO(id_usuario),

    CONSTRAINT UQ_EVALUACION_DONANTE
        UNIQUE (id_evaluacion, id_donante),

    CONSTRAINT CK_EVALUACION_RESULTADO
        CHECK (resultado IN ('Apto','No apto','Pendiente'))
);
GO

-- 8. TABLA DONACION
CREATE TABLE dbo.DONACION (
    id_donacion INT IDENTITY(1,1) PRIMARY KEY,
    id_donante INT NOT NULL,
    id_evaluacion INT NOT NULL UNIQUE,
    fecha_donacion DATE NOT NULL DEFAULT GETDATE(),
    cantidad_ml INT NOT NULL,
    estado VARCHAR(30) NOT NULL DEFAULT 'Registrada',

    CONSTRAINT FK_DONACION_DONANTE
        FOREIGN KEY (id_donante)
        REFERENCES dbo.DONANTE(id_donante),

    CONSTRAINT FK_DONACION_EVALUACION
        FOREIGN KEY (id_evaluacion, id_donante)
        REFERENCES dbo.EVALUACION_DONANTE(id_evaluacion, id_donante),

    CONSTRAINT CK_DONACION_CANTIDAD
        CHECK (cantidad_ml > 0),

    CONSTRAINT CK_DONACION_ESTADO
        CHECK (estado IN ('Registrada','Procesada','Anulada'))
);
GO

-- 9. TABLA PARTICIPACION_CAMPANIA
CREATE TABLE dbo.PARTICIPACION_CAMPANIA (
    id_participacion INT IDENTITY(1,1) PRIMARY KEY,
    id_donante INT NOT NULL,
    id_campania INT NOT NULL,
    fecha_registro DATE NOT NULL DEFAULT GETDATE(),
    estado VARCHAR(30) NOT NULL DEFAULT 'Inscrito',

    CONSTRAINT FK_PARTICIPACION_DONANTE
        FOREIGN KEY (id_donante)
        REFERENCES dbo.DONANTE(id_donante),

    CONSTRAINT FK_PARTICIPACION_CAMPANIA
        FOREIGN KEY (id_campania)
        REFERENCES dbo.CAMPANIA(id_campania),

    CONSTRAINT UQ_PARTICIPACION
        UNIQUE (id_donante, id_campania),

    CONSTRAINT CK_PARTICIPACION_ESTADO
        CHECK (estado IN (
            'Inscrito','Asistio','No asistio','Cancelado'
        ))
);
GO

-- 10. TABLA UNIDAD_INVENTARIO
CREATE TABLE dbo.UNIDAD_INVENTARIO (
    id_unidad INT IDENTITY(1,1) PRIMARY KEY,
    id_donacion INT NOT NULL,
    codigo VARCHAR(50) NOT NULL UNIQUE,
    componente_sanguineo VARCHAR(50) NOT NULL,
    grupo_sanguineo VARCHAR(2) NOT NULL,
    factor_rh VARCHAR(3) NOT NULL,
    volumen_ml INT NOT NULL,
    fecha_extraccion DATE NOT NULL,
    fecha_vencimiento DATE NOT NULL,
    estado VARCHAR(30) NOT NULL DEFAULT 'Disponible',

    CONSTRAINT FK_UNIDAD_DONACION
        FOREIGN KEY (id_donacion)
        REFERENCES dbo.DONACION(id_donacion),

    CONSTRAINT CK_UNIDAD_GRUPO
        CHECK (grupo_sanguineo IN ('A','B','AB','O')),

    CONSTRAINT CK_UNIDAD_RH
        CHECK (factor_rh IN ('+','-')),

    CONSTRAINT CK_UNIDAD_VOLUMEN
        CHECK (volumen_ml > 0),

    CONSTRAINT CK_UNIDAD_FECHAS
        CHECK (fecha_vencimiento > fecha_extraccion),

    CONSTRAINT CK_UNIDAD_COMPONENTE
        CHECK (componente_sanguineo IN (
            'Concentrado de globulos rojos',
            'Plaquetas',
            'Plasma'
        )),

    CONSTRAINT CK_UNIDAD_ESTADO
        CHECK (estado IN (
            'Disponible','Reservada','Utilizada','Vencida'
        ))
);
GO


